# Environment
.env
*.env
.env.*
.env.local
# ...except the template. README, CONTRIBUTING and the first-time guide all
# say `cp .env.example`, and `.env.*` above was quietly matching it, so the
# quickstart referred to a file that could never be committed.
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Logs
*.log
server.log
feedback.log

# Data — too large for GitHub
cache/
data/
chromadb/

# Editor
.vscode/
*.code-workspace
.idea/

# OS
.DS_Store
Thumbs.db

# Test output
cdss_test_report_*.txt
cdss_test_results_*.json

# Keys
*.pem
*.key

# Manufacturer operator manuals. Device cards are the owner's AUTHORED SUMMARY
# referencing these; the manuals themselves are third-party copyrighted works
# and must never be committed. Defensive: vent_module.lint_device_cards()
# checks card text against manual text when it is present locally, and this
# keeps "present locally" from becoming "present in the repo".
*.manual.*
.manual.
manuals/
# Local working files (review docs, drafts, old versions)
EdgeCDSS_openai_*
*.docx
# NOT `tests/`. That rule was here until 2026-08-26 and it matched ANY
# directory of that name at any depth — so the day anyone moved the suite into
# server/tests/, the entire offline regression suite would have become
# untracked, silently, while still passing locally. It was harmless only for
# as long as the tests sat flat beside the code.

# Runtime logs
logs/
*.jsonl

# Change logs — an audit trail of a deployment, not source.
server/drug_concentrations.log.jsonl
server/drug_contracts.log.jsonl
server/drug_concentrations.json
