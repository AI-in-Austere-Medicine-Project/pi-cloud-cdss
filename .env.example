# EdgeCDSS — environment template.
#
# Copy to server/.env and fill in. Never commit the filled-in copy: .gitignore
# ignores .env and .env.* and makes a single exception for THIS file.
#
# Nothing here is required to run the offline test suite. It needs no key, no
# network and no vector database — that is the point of it.

# ── Access ──────────────────────────────────────────────────────────────────
# The API token every gated route requires. Change it. The published demo
# token is for the public demo only and grants the same access to anyone.
CDSS_ACCESS_TOKEN=change-me

# ── Model providers ─────────────────────────────────────────────────────────
# A provider with no key is absent from the dropdown rather than broken, so
# set only the ones you have. Names come from providers.json's own key_env
# declarations — add a provider there and the redactor covers it automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# An OpenAI-compatible local endpoint (Ollama, llama.cpp, vLLM). Config, not code.
CDSS_LOCAL_BASE_URL=
CDSS_LOCAL_API_KEY=

# Override the registry's choices without editing providers.json, for A/B runs.
CDSS_DEFAULT_MODEL=
CDSS_VALIDATOR_MODEL=

# ── Voice (optional) ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# ── Paths and storage (optional; sensible defaults) ─────────────────────────
CHROMADB_PATH=
CDSS_LOG_DIR=
FEEDBACK_LOG=
